{
  "name": "puckbuddy-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "assets:audit": "node scripts/audit-public-assets.mjs",
    "assets:audit:fail": "node scripts/audit-public-assets.mjs --fail-on-unused",
    "assets:audit:runtime": "node scripts/audit-public-assets.mjs --scope=runtime",
    "assets:audit:scripts": "node scripts/audit-public-assets.mjs --scope=scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:repository": "python3 scripts/check-repository.py && python3 -m unittest discover -s scripts -p test_repository_conventions.py"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^1.2.0",
    "framer-motion": "^12.23.24",
    "geist": "^1.7.2",
    "next": "15.5.27",
    "nodemailer": "^10.1.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^29.1.1",
    "puppeteer": "^24.37.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  }
}
